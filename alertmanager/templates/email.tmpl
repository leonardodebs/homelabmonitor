{{ define "homelab.email.html" }}
<!doctype html>
<html lang="pt-BR">
  <body style="margin:0;background:#f4f5f7;color:#1f2937;font-family:Arial,sans-serif;">
    <div style="max-width:680px;margin:0 auto;padding:24px;">
      <div style="background:#111827;border-radius:10px;padding:24px;color:#f9fafb;">
        {{ if eq .Status "firing" }}
        <div style="color:#fca5a5;font-size:13px;font-weight:bold;text-transform:uppercase;">Alerta ativo</div>
        {{ else }}
        <div style="color:#86efac;font-size:13px;font-weight:bold;text-transform:uppercase;">Alerta resolvido</div>
        {{ end }}
        <h1 style="font-size:24px;margin:8px 0 0;">{{ .CommonLabels.alertname }}</h1>
      </div>

      {{ range .Alerts }}
      <div style="background:#ffffff;border-radius:10px;margin-top:16px;padding:24px;border:1px solid #e5e7eb;">
        {{ if .Annotations.summary }}
        <h2 style="font-size:18px;margin:0 0 12px;">{{ .Annotations.summary }}</h2>
        {{ end }}
        {{ if .Annotations.description }}
        <p style="font-size:14px;line-height:1.55;margin:0 0 18px;">{{ .Annotations.description }}</p>
        {{ end }}

        <p style="font-size:13px;color:#6b7280;margin:0 0 18px;">
          Severidade: <strong>{{ .Labels.severity }}</strong>
          {{ if .Labels.instance }} &middot; Instância: <strong>{{ .Labels.instance }}</strong>{{ end }}
        </p>

        {{ if eq .Labels.service "restic" }}
        <a href="http://192.168.100.3:3000/d/restic-homelab/restic-homelab?orgId=1&amp;from=now-15d&amp;to=now&amp;timezone=browser"
           style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:11px 16px;border-radius:7px;font-weight:bold;">
          Abrir Restic HomeLab no Grafana
        </a>
        {{ else if eq .Labels.server "dell" }}
        <a href="http://192.168.100.3:3000/d/dell-overview/dell-overview?orgId=1&amp;from=now-6h&amp;to=now&amp;timezone=browser"
           style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:11px 16px;border-radius:7px;font-weight:bold;">
          Abrir Dell Overview no Grafana
        </a>
        {{ else }}
        <a href="http://192.168.100.3:3000/d/homelab-overview/homelab-overview?orgId=1&amp;from=now-6h&amp;to=now&amp;timezone=browser"
           style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:11px 16px;border-radius:7px;font-weight:bold;">
          Abrir Homelab Overview no Grafana
        </a>
        {{ end }}
      </div>
      {{ end }}

      <p style="font-size:12px;color:#6b7280;margin:18px 4px 0;">
        Mensagem gerada pelo Prometheus e enviada pelo Alertmanager do HomeLab.
        O dashboard está disponível somente na rede local.
      </p>
    </div>
  </body>
</html>
{{ end }}
